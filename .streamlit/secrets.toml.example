# Copiar a .streamlit/secrets.toml y completar.
# secrets.toml NO debe subirse al repositorio (ver .gitignore).
#
# Usar la clave `anon` del proyecto, no la `service_role`: la anónima
# queda acotada por las políticas de Row Level Security definidas en
# supabase_schema.sql. La service_role las ignora todas.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "clave-anon-del-proyecto"
